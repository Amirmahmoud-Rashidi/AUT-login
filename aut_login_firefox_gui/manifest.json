{
  "manifest_version": 3,
  "name": "AUT Ultimate Login",
  "version": "4.1",
  "permissions": [
    "storage",
    "tabs"
  ],
  "icons": {
    "48": "icon.png",
    "96": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "تنظیمات AUT Ultimate Login",
    "default_icon": {
      "48": "icon.png",
      "96": "icon.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://portal.aut.ac.ir/*",
        "*://courses.aut.ac.ir/*",
        "*://internet.aut.ac.ir/*",
        "*://accounts.aut.ac.ir/*",
        "*://webmail.aut.ac.ir/*",
        "*://lmshome.aut.ac.ir/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "aut-ultimate-login@aut.ac.ir",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
